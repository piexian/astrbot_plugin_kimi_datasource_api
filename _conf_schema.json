{
  "oauth_settings": {
    "type": "object",
    "description": "OAuth 登录设置",
    "hint": "控制 Kimi Code 设备码登录流程",
    "items": {
      "oauth_host": {
        "type": "string",
        "description": "OAuth 服务地址",
        "hint": "通常无需修改",
        "default": "https://auth.kimi.com"
      },
      "login_timeout_seconds": {
        "type": "int",
        "description": "登录等待超时（秒）",
        "hint": "设备码授权总等待时间，默认 15 分钟",
        "default": 900,
        "slider": {
          "min": 60,
          "max": 1800,
          "step": 30
        }
      }
    }
  },
  "connection_settings": {
    "type": "object",
    "description": "连接设置",
    "hint": "控制 OAuth 与 datasource API 请求",
    "items": {
      "request_timeout_seconds": {
        "type": "int",
        "description": "请求超时（秒）",
        "hint": "单次 HTTP 请求最大等待时间",
        "default": 30,
        "slider": {
          "min": 5,
          "max": 120,
          "step": 5
        }
      },
      "proxy": {
        "type": "string",
        "description": "HTTP 代理地址",
        "hint": "例如: http://127.0.0.1:7890，留空则不使用代理",
        "default": ""
      }
    }
  },
  "datasource_settings": {
    "type": "object",
    "description": "Datasource 设置",
    "hint": "控制 Kimi datasource API 与响应处理",
    "items": {
      "api_url": {
        "type": "string",
        "description": "Datasource API 地址",
        "hint": "默认使用 Kimi Code 官方 datasource endpoint；global 区填 https://api.kimi.ai/coding/v1/tools",
        "default": "https://api.kimi.com/coding/v1/tools"
      },
      "response_parse_mode": {
        "type": "string",
        "description": "响应解析模式",
        "hint": "official 对齐官方 MCP（assistant 通道优先，user 兜底）；legacy_zip 只要 user 通道的干净 data_preview",
        "default": "official",
        "options": [
          "official",
          "legacy_zip"
        ]
      },
      "save_response_files": {
        "type": "bool",
        "description": "保存响应文件",
        "hint": "将上游 response.files 安全写入插件数据目录",
        "default": true
      }
    }
  },
  "account_settings": {
    "type": "object",
    "description": "账号设置",
    "hint": "凭据文件列表统一管理启用账号；旧账号自动接入，无需重新登录",
    "items": {
      "monthly_cooldown_minutes": {
        "type": "int",
        "description": "月度额度冷却（分钟）",
        "hint": "收到月度额度耗尽错误后暂停业务请求；到期仅在下一次调用时单次复核，不代表官方额度重置。",
        "default": 60,
        "slider": {
          "min": 1,
          "max": 1440,
          "step": 1
        }
      },
      "account_files": {
        "type": "list",
        "description": "旧文件列表（内部迁移）",
        "invisible": true,
        "items": {"type": "string"},
        "default": []
      },
      "credential_imports": {
        "type": "file",
        "description": "凭据文件",
        "hint": "上传或添加文件后保存即启用；登录自动加入，刷新同步更新。替换已有账号时先删除并保存，再上传新文件。",
        "file_types": ["json"],
        "default": []
      },
      "account_ids": {
        "type": "list",
        "description": "旧版账号（仅迁移兼容）",
        "invisible": true,
        "hint": "自动迁移完成后清空，此后使用凭据文件列表，不再按此列表删除账号。",
        "items": {
          "type": "string"
        },
        "default": []
      }
    }
  }
}
